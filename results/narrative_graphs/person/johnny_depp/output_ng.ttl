ng:Betty_Taylor_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Betty Taylor" ;
    sem:hasTimeStamp "1995-01-01"^^xsd:date ;
    rdfs:comment "Betty Taylor (October 7, 1919 – June 4, 2011) was an American actress and performer, best known as \"Slue Foot Sue\" in Disneyland's Golden Horseshoe Revue, opposite Wally Boag. Taylor died on June 4, 2011, at the age of 91, the day after Boag died." .

