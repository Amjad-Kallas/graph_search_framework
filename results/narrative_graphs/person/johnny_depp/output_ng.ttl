ng:Jimmy_MacDonald_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Jimmy MacDonald" ;
    sem:hasTimeStamp "1993-01-01"^^xsd:date ;
    rdfs:comment "John James MacDonald (May 19, 1906 – February 1, 1991) was an English-born American foley artist and voice actor. He was the original head of the Disney sound-effects department and was also the second official voice of Mickey Mouse from 1947 to 1976 after Walt Disney stopped playing the character and before Wayne Allwine became the third voice of Mickey in 1977." .

