ng:Richard_Attenborough_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Richard Attenborough" ;
    sem:hasTimeStamp "1923-08-29"^^xsd:date ;
    rdfs:comment "Richard Samuel Attenborough, Baron Attenborough ( AT-ten-bər-rə; 29 August 1923 – 24 August 2014), was an English actor, film director and producer. For his directing, he won two Academy Awards, three BAFTA Awards, and four Golden Globe Awards; for his acting, he won three BAFTAs and two Golden Globes. He was knighted in 1976 for services to film and in 1983 he received the BAFTA Fellowship for lifetime achievement." .

ng:Richard_Dreyfuss_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Richard Dreyfuss" ;
    sem:hasTimeStamp "1978-01-01"^^xsd:date ;
    rdfs:comment "Richard Stephen Dreyfuss ( DRY-fəs; né Dreyfus; born October 29, 1947) is an American actor. He emerged from the New Hollywood wave of American cinema, finding fame with a succession of leading man parts in the 1970s. He has received an Academy Award, a BAFTA, and a Golden Globe." .

ng:Richard_Fleischer_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
