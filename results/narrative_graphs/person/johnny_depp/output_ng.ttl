ng:Lily_Rose_Depp_father_Johnny_Depp a sem:Event ;
    ng:object "Johnny Depp" ;
    ng:property "father" ;
    ng:relatesTo ng:Johnny_Depp_child_Lily_Rose_Depp ;
    ng:subject "Lily-Rose Depp" ;
    sem:hasTimeStamp "1999-05-27"^^xsd:date ;
    rdfs:comment "Lily-Rose Melody Depp (born May 27, 1999) is a French and American actress and singer. Born to actors Johnny Depp and Vanessa Paradis, she began her acting career in film with a minor role in Tusk (2014) and pursued a career as a fashion model. She appeared in the period dramas The Dancer (2016) and The King (2019), and the romantic comedy A Faithful Man (2018)." .

