    sem:hasTimeStamp "2006-01-01"^^xsd:date ;
    rdfs:comment "This is a following list of the MTV Movie Award Winners and Nominees for Best Performance from 1992 on Awards. In all but five years, the awards are separated into male and female categories." .

ng:Macaulay_Culkin_award_received_MTV_Movie_Awards a sem:Event ;
    ng:object "MTV Movie Awards" ;
    ng:property "award received" ;
    ng:subject "Macaulay Culkin" ;
    sem:hasTimeStamp "1980-08-26"^^xsd:date ;
    rdfs:comment "Macaulay Macaulay Culkin Culkin (born Macaulay Carson Culkin; August&#160;26,&#160;1980&#160;(1980-08-26)) is an American actor and musician. Considered one of the most successful child actors of the 1990s, Culkin has received several accolades including a Golden Globe Award nomination. In 2005, he was ranked second on VH1's list of the \"100 Greatest Kid-Stars\"." .

ng:Manuel_Gonzales_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Manuel Gonzales" ;
    sem:hasTimeStamp "2017-01-01"^^xsd:date ;
    rdfs:comment "Manuel Gonzales (March 3, 1913 – March 31, 1993) was a Spanish-American Disney comics artist. He worked on the Mickey Mouse comic strip from 1940 to 1981." .

