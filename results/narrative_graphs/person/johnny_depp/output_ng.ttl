ng:Drew_Barrymore_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Drew Barrymore" ;
    sem:hasTimeStamp "2010-01-01"^^xsd:date ;
    rdfs:comment "Drew Blythe Barrymore (born February 22, 1975) is an American actress, producer, talk show host, and businesswoman. A member of the Barrymore family of actors, she has received multiple awards and nominations, including a Golden Globe Award, an Emmy Award, and an Actor Award. She was named one of the 100 most influential people in the world by Time in 2023." .

ng:Dudley_Moore_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Dudley Moore" ;
    sem:hasTimeStamp "1935-04-19"^^xsd:date ;
    rdfs:comment "Dudley Stuart John Moore (19 April 1935&#160;– 27 March 2002) was an English actor, comedian, musician and composer. He first came to prominence in the UK as a leading figure in the British satire boom of the 1960s. He was one of the four writer-performers in the groundbreaking satirical comedy revue Beyond the Fringe from 1960 to 1964." .

ng:Ed_Harris_award_received_Golden_Globe_Award a sem:Event ;
