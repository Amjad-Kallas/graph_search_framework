    ng:subject "Salvatore Camarata" ;
    sem:hasTimeStamp "2003-01-01"^^xsd:date ;
    rdfs:comment "Salvador \"Tutti\" Camarata (May 11, 1913 – April 13, 2005) was an American composer, arranger, trumpeter, and record producer. He was also known as \"Toots\" Camarata." .

ng:Sam_Rockwell_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
