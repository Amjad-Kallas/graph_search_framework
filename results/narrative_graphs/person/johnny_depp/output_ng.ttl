ng:Lillian_Disney_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Lillian Disney" ;
    sem:hasTimeStamp "2003-01-01"^^xsd:date ;
    rdfs:comment "Lillian Marie Disney (née Bounds; February 15, 1899&#160;– December 16, 1997) was an American ink artist at the Walt Disney Animation Studios and the wife of Walt Disney from 1925 until his death in 1966. Born in Spalding, Idaho, Disney graduated from high school in Lapwai before moving to Lewiston to attend college. She left Idaho in 1923 to move to Southern California, where she met future husband Walt while working as a secretary for his company." .

