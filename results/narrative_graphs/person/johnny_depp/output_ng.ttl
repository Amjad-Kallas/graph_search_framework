ng:Bill_Farmer_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Bill Farmer" ;
    sem:hasTimeStamp "2009-01-01"^^xsd:date ;
    rdfs:comment "Bill Farmer (born November 14, 1952) is an American voice actor, comedian and impressionist. He has performed the voice of the Disney character Goofy since 1987, and has also been the voice of Pluto and Horace Horsecollar since 1990." .

