    sem:hasTimeStamp "2000-10-12"^^xsd:date .

ng:Guillermo_del_Toro_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Guillermo del Toro" ;
    sem:hasTimeStamp "2018-01-01"^^xsd:date .

ng:Guy_Williams_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Guy Williams" ;
    sem:hasTimeStamp "2011-01-01"^^xsd:date .

ng:Halle_Berry_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Halle Berry" ;
    sem:hasTimeStamp "2000-01-01"^^xsd:date ;
    rdfs:comment "Halle Maria Berry ( HAL-ee; born Maria Halle Berry; August 14, 1966) is an American actress. She began her career as a model and beauty contestant becoming Miss Ohio USA in 1986, first runner-up in Miss USA 1986 and placing sixth in Miss World 1986. Her early film roles include Boomerang (1992), The Flintstones (1994) and Bulworth (1998)." .

ng:Hamilton_Luske_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Hamilton Luske" ;
    sem:hasTimeStamp "1999-01-01"^^xsd:date .

ng:Harper_Goff_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Harper Goff" ;
    sem:hasTimeStamp "1993-01-01"^^xsd:date ;
    rdfs:comment "Harper Goff (March 16, 1911&#160;– March 3, 1993), born Ralph Harper Goff, was an American artist, musician, and actor. For many years, he was associated with The Walt Disney Company, in the process of which he contributed to various major films, as well as to the planning of the Disney theme parks. During World War II, he was also an advisor to the U.S. Army on camouflage (Blechman 2004; Behrens 2009)." .

ng:Harriet_Burns_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Harriet Burns" ;
    sem:hasTimeStamp "2000-01-01"^^xsd:date .

ng:Harrison_Price_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Harrison Price" ;
    sem:hasTimeStamp "2003-01-01"^^xsd:date ;
    rdfs:comment "Harrison Alan \"Buzz\" Price (May 17, 1921 – August 15, 2010) was an American research economist specializing in how people spend their leisure time and resources. Price guided Walt Disney in the siting and development of Disneyland in Southern California and of Walt Disney World in Central Florida." .

ng:Hayley_Mills_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Hayley Mills" ;
    sem:hasTimeStamp "1998-01-01"^^xsd:date ;
    rdfs:comment "Hayley Catherine Rose Vivien Mills (born 18 April 1946) is an English actress. A daughter of Sir John Mills and Mary Hayley Bell and younger sister of actress Juliet Mills, she began her acting career as a child and was hailed as a promising newcomer, winning the BAFTA Award for Most Promising Newcomer for her performance in the British crime drama film Tiger Bay (1959), the Academy Juvenile Award for Disney's Pollyanna (1960) and Golden Globe Award for New Star of the Year&#160;– Actress in 1961. During her early career, Mills appeared in six films for Walt Disney, including her" .

ng:Helen_Hunt_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Helen Hunt" ;
    sem:hasTimeStamp "1994-01-01"^^xsd:date ;
    rdfs:comment "Helen Elizabeth Hunt (born June 15, 1963) is an American actress. Her accolades include an Academy Award, four Primetime Emmy Awards, and four Golden Globe Awards. Hunt rose to fame portraying newlywed Jamie Buchman in the sitcom Mad About You (1992–1999), which earned her three Golden Globe Awards for Best Actress and four Primetime Emmy Awards for Lead Actress." .

ng:Howard_Ashman_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Howard Ashman" ;
    sem:hasTimeStamp "2001-01-01"^^xsd:date ;
    rdfs:comment "Howard Elliott Ashman (May 17, 1950 – March 14, 1991) was an American playwright, lyricist, and stage director. He is most widely known for his work on feature films for Walt Disney Animation Studios, for which Ashman wrote the lyrics and Alan Menken composed the music. Ashman has been credited as being a main driving force behind the Disney Renaissance." .

ng:Howard_Shore_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Howard Shore" ;
    sem:hasTimeStamp "1946-10-18"^^xsd:date ;
    rdfs:comment "Howard Leslie Shore (born October 18, 1946) is a Canadian composer, conductor, and orchestrator noted for his film scores. He has composed the scores for over 80 films, most notably the scores for Peter Jackson's The Lord of the Rings and The Hobbit film trilogies, both of which are based on the fantasy works by English author J. R. R. Tolkien. He is a consistent collaborator with director David Cronenberg, having scored all but one of his films since 1979, and collaborated with Martin Scorsese on six of his films." .

ng:Hugh_Grant_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Hugh Grant" ;
    sem:hasTimeStamp "1995-01-01"^^xsd:date ;
    rdfs:comment "Hugh John Mungo Grant (born 9 September 1960) is an English actor. He established himself early in his career as a charming and vulnerable romantic leading man, and has since transitioned into a character actor. He has received several accolades including a British Academy Film Award and a Golden Globe Award as well as nominations for two Primetime Emmy Awards." .

