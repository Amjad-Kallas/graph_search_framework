    ng:subject "David Tomlinson" ;
    sem:hasTimeStamp "2002-01-01"^^xsd:date .

ng:Dean_Jones_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Dean Jones" ;
    sem:hasTimeStamp "1995-01-01"^^xsd:date ;
    rdfs:comment "Dean Carroll Jones (January 25, 1931&#160;– September 1, 2015) was an American actor. He was best known as the Walt Disney Company's main leading man in the 1970s with his roles as Agent Zeke Kelso in That Darn Cat! (1965), Jim Douglas in the Herbie franchise (1969–1997), and with other film companies such as Dr. Herman Varnick in Beethoven (1992)." .

ng:Diane_Keaton_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Diane Keaton" ;
    sem:hasTimeStamp "1978-01-01"^^xsd:date ;
    rdfs:comment "Diane Keaton (née Hall; January 5, 1946 – October 11, 2025) was an American actress. Her career spanned more than five decades, during which she rose to prominence in the New Hollywood movement. She collaborated frequently with Woody Allen, appearing in eight of his films." .

ng:Dick_Clark_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Dick Clark" ;
    sem:hasTimeStamp "2013-01-01"^^xsd:date ;
    rdfs:comment "Richard Wagstaff Clark (November 30, 1929&#160;– April 18, 2012) was an American television and radio personality and television producer who hosted American Bandstand from 1956 to 1989. He also hosted five incarnations of the Pyramid game show from 1973 to 1988 and Dick Clark's New Year's Rockin' Eve, which broadcast New Year's Eve celebrations in New York City's Times Square. As host of American Bandstand, Clark introduced rock and roll to many Americans." .

ng:Dick_Huemer_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Dick Huemer" ;
    sem:hasTimeStamp "2007-01-01"^^xsd:date ;
    rdfs:comment "Richard Huemer (January 2, 1898 – November 30, 1979) was an American animator in the Golden Age of Animation." .

