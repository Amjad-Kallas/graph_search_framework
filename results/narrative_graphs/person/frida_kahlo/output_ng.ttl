ng:My_Dress_Hangs_There_creator_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "creator" ;
    ng:subject "My Dress Hangs There" ;
    sem:hasTimeStamp "1933-01-01"^^xsd:date ;
    rdfs:comment "My Dress Hangs There (1933) is an oil painting and collage by Mexican artist Frida Kahlo. Kahlo began this painting while staying in New York City with her husband, Diego Rivera, and completed it after the couple returned to their home in Mexico City. The painting was shown to the public for the first time at the Levy Gallery in New York in 1938 with the title My Dress Was There Hanging, and was shown again in Paris in 1939 with the title Ma robe était pendue là." .

