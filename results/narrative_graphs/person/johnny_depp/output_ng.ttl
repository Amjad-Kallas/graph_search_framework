    ng:subject "Misha Collins" ;
    sem:hasTimeStamp "1974-08-20"^^xsd:date .

ng:Morgan_Freeman_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
