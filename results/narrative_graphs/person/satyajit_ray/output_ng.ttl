ng:author_Satyajit_Ray a sem:Event ;
    ng:object "Satyajit Ray" ;
    ng:property "author" ;
    ng:subject "অপ্সরা থিয়েটারের মামলা",
        "অম্বর সেন অন্তর্ধান রহস্য",
        "ইন্দ্রজাল রহস্য",
        "এবার কান্ড কেদারনাথে",
        "কৈলাস চৌধুরীর পাথর",
        "গোঁসাইপুর সরগরম",
        "গোরস্থানে সাবধান!",
        "জয়বাবা ফেলুনাথ",
        "ডবল ফেলুদা",
        "ডাঃ মুনসীর ডায়রি",
        "নয়ন রহস্য",
        "ফেলুদা ওয়ান ফেলুদা টু",
        "ফেলুদা প্লাস ফেলুদা",
        "বোম্বাইয়ের বোম্বেটে",
        "বোসপুকুরে খুনখারাপি",
        "রবার্টসনের রুবি",
        "লন্ডনে ফেলুদা",
        "শকুন্তলার কণ্ঠহার",
        "সমাদ্দারের চাবি" ;
    sem:hasTimeStamp "1921-05-02"^^xsd:date .

