ng:Arbol_de_la_Esperanza_Mantente_Firme_creator_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "creator" ;
    ng:subject "Arbol de la Esperanza, Mantente Firme" ;
    sem:hasTimeStamp "1907-07-06"^^xsd:date .

ng:Cristina_Kahlo_sibling_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "sibling" ;
    ng:relatesTo ng:Frida_Kahlo_sibling_Cristina_Kahlo ;
    ng:subject "Cristina Kahlo" ;
    sem:hasTimeStamp "1908-06-07"^^xsd:date ;
    rdfs:comment "Cristina Kahlo y Calderón (7 June 1908 – 8 February 1964) was the sister of artist Frida Kahlo. Frida painted a portrait of Cristina, titled Portrait of Cristina, My Sister, and Diego Rivera, Frida's husband, also portrayed Cristina Kahlo in his work. Cristina, with whom Rivera had an affair, was painted by Rivera in the nude." .

ng:Diego_Rivera_spouse_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "spouse" ;
    ng:relatesTo ng:Diego_Rivera_vida_y_obra_cast_member_Diego_Rivera,
        ng:Frida_Kahlo_Tina_Modotti_cast_member_Diego_Rivera,
        ng:Frida_Kahlo_spouse_Diego_Rivera ;
    ng:subject "Diego Rivera" ;
    sem:hasTimeStamp "1929-08-21"^^xsd:date ;
    rdfs:comment "Diego María de la Concepción Juan Nepomuceno Estanislao de la Rivera y Barrientos Acosta y Rodríguez (Spanish pronunciation: [ˈdjeɣo riˈβeɾa]; December 8, 1886 – November 24, 1957) was a Mexican painter. His large frescoes helped establish the mural movement in Mexican and international art. Between 1922 and 1953, Rivera painted murals in, among other places, Mexico City, Chapingo, and Cuernavaca in Mexico, and San Francisco, Detroit, and New York City in the United States." .

ng:Diego_Rivera_vida_y_obra_cast_member_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "cast member" ;
    ng:subject "Diego Rivera; vida y obra" ;
    sem:hasTimeStamp "1907-07-06"^^xsd:date .

ng:Diego_and_I_creator_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "creator" ;
    ng:subject "Diego and I" ;
    sem:hasTimeStamp "1949-01-01"^^xsd:date ;
    rdfs:comment "Diego and I (Spanish: Diego y yo) is an oil on canvas painting by the Mexican artist Frida Kahlo, from 1949. In November 2021, it sold at auction in Sotheby's New York for US$34.9 million, a record at the time for a Kahlo work, and for a work by a Latin American artist. It shattered the record previously held by the painting The Rivals (1931) by her husband Diego Rivera (1886-1957) who appears on her forehead in this work." .

ng:Evocaci_n_de_Frida_cast_member_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "cast member" ;
    ng:subject "Evocación de Frida" ;
    sem:hasTimeStamp "1907-07-06"^^xsd:date .

ng:Frida_Kahlo_Tina_Modotti_cast_member_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "cast member" ;
    ng:subject "Frida Kahlo & Tina Modotti" ;
    sem:hasTimeStamp "1907-07-06"^^xsd:date .

ng:Frida_Kahlo_cast_member_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "cast member" ;
    ng:subject "Frida Kahlo" ;
    sem:hasTimeStamp "1907-07-06"^^xsd:date ;
    rdfs:comment "Magdalena Carmen Frida Kahlo y Calderón (Spanish pronunciation: [ˈfɾiða ˈkalo]; 6 July 1907 – 13 July 1954) was a Mexican painter known for her many portraits, self-portraits, and works inspired by the nature and artifacts of Mexico. Inspired by the country's popular culture, she employed a naïve folk art style to explore questions of identity, postcolonialism, gender, class, and race in Mexican society. Her paintings often had strong autobiographical elements and mixed realism with fantasy." .

ng:Frida_and_Diego_Rivera_creator_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "creator" ;
    ng:subject "Frida and Diego Rivera" ;
    sem:hasTimeStamp "1931-01-01"^^xsd:date ;
    rdfs:comment "Frieda and Diego Rivera (Frieda y Diego Rivera in Spanish) is a 1931 oil painting by Mexican artist Frida Kahlo. This portrait was created two years after Frida Kahlo and Diego Rivera married, and is widely considered a wedding portrait. The painting shows Kahlo standing next to her husband and fellow artist, Rivera." .

ng:Fulang_Chang_and_I_creator_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "creator" ;
    ng:subject "Fulang-Chang and I" ;
    sem:hasTimeStamp "1937-01-01"^^xsd:date .

ng:Guillermo_Kalho_child_Frida_Kahlo a sem:Event ;
    ng:object "Frida Kahlo" ;
    ng:property "child" ;
    ng:relatesTo ng:Frida_Kahlo_father_Guillermo_Kalho ;
    ng:subject "Guillermo Kalho" ;
    sem:hasTimeStamp "1871-10-26"^^xsd:date ;
    rdfs:comment "Guillermo Kahlo (born Carl Wilhelm Kahlo; 26 October 1871 – 14 April 1941) was a German-born Mexican-naturalized photographer. He photographically documented important architectural works, churches, streets, landmarks, as well as industries and companies in Mexico at the beginning of the 20th century; because of this, his work has not only artistic value but also historical and documental importance. He was the father of painter Frida Kahlo." .

ng:Marxism_Will_Give_Health_to_the_Sick_creator_Frida_Kahlo a sem:Event ;
