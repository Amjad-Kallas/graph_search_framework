ng:Elizabeth_Taylor_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Elizabeth Taylor" ;
    sem:hasTimeStamp "1960-01-01"^^xsd:date ;
    rdfs:comment "Dame Elizabeth Rosemond Taylor (February 27, 1932 – March 23, 2011) was a British and American actress. She began her career as a child actress in the early 1940s and was one of the most popular stars of classical Hollywood cinema in the 1950s. She then became the world's highest-paid movie star in the 1960s, remaining a well-known public figure for the rest of her life." .

ng:Elton_John_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
