ng:Steve_Buscemi_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Steve Buscemi" ;
    sem:hasTimeStamp "2011-01-01"^^xsd:date ;
    rdfs:comment "Steven Vincent Buscemi ( boo-SEM-ee, Italian: [buʃˈʃɛːmi]; born December 13, 1957) is an American actor, director, and producer. His accolades include two Emmy Awards, a Golden Globe Award and two Independent Spirit Awards. Buscemi started his acting career with the independent productions Parting Glances (1986), Mystery Train (1989), and In the Soup (1992), following such roles with his breakthrough in Quentin Tarantino's Reservoir Dogs (1992)." .

ng:Steve_Jobs_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Steve Jobs" ;
    sem:hasTimeStamp "2013-01-01"^^xsd:date .

ng:Steve_Martin_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Steve Martin" ;
    sem:hasTimeStamp "2005-01-01"^^xsd:date ;
    rdfs:comment "Stephen Glenn Martin (born August 14, 1945) is an American comedian, actor, writer, producer, and musician. Known for his work in comedy films, television, and recording, he has received many accolades, including five Grammy Awards, a Primetime Emmy Award, and a Screen Actors Guild Award as well as nominations for eight Golden Globe Awards and two Tony Awards. Martin received the Mark Twain Prize for American Humor in 2005, the Kennedy Center Honors in 2007, the Honorary Academy Award in 2013, and an AFI Life Achievement Award in 2015." .

ng:Steven_Spielberg_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Steven Spielberg" ;
    sem:hasTimeStamp "1994-01-01"^^xsd:date ;
    rdfs:comment "Steven Allan Spielberg (; born December 18, 1946) is an American filmmaker. A major figure of the New Hollywood era and pioneer of the modern blockbuster, Spielberg is widely regarded as one of the greatest and most influential filmmakers in the history of cinema and is the highest-grossing film director of all time. Among other accolades, he has received three Academy Awards, four Golden Globe Awards, four BAFTA Awards, twelve Emmy Awards, a Tony Award, and a Grammy Award, as well as the AFI Life Achievement Award in 1995, an honorary knighthood in 2001, the Kennedy Center Honor in 2006," .

ng:Steven_Zaillian_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Steven Zaillian" ;
    sem:hasTimeStamp "1953-01-30"^^xsd:date .

ng:Sue_Ane_Langdon_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Sue Ane Langdon" ;
    sem:hasTimeStamp "1936-03-08"^^xsd:date .

ng:Susan_Lucci_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Susan Lucci" ;
    sem:hasTimeStamp "2015-01-01"^^xsd:date ;
    rdfs:comment "Susan Victoria Lucci (born December 23, 1946) is an American actress. She is best known for portraying Erica Kane on the ABC daytime drama All My Children during that show's entire network run from 1970 to 2011. The character is considered an icon, and she was called \"Daytime's Leading Lady\" by TV Guide, with The New York Times and the Los Angeles Times citing her as the highest-paid actor in daytime television." .

ng:Sylvester_Stallone_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Sylvester Stallone" ;
    sem:hasTimeStamp "2016-01-01"^^xsd:date ;
    rdfs:comment "Sylvester Gardenzio Stallone ( stə-LOHN; born July 6, 1946) is an American actor, painter, and filmmaker. In a film career spanning more than fifty years, Stallone has received numerous accolades, including a Golden Globe Award and a Critics' Choice Award, as well as nominations for three Academy Awards and two BAFTA Awards. Stallone is one of only two actors in history (alongside Harrison Ford) to have starred in a box-office No.&#160;1 film across six consecutive decades." .

ng:Thomas_Murphy_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
