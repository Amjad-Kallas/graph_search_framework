    sem:hasTimeStamp "1991-01-01"^^xsd:date .

ng:Mary_Costa_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Mary Costa" ;
    sem:hasTimeStamp "1999-01-01"^^xsd:date ;
    rdfs:comment "Mary Costa (born April 5, 1930) is an American retired actress and singer. Her most notable film credit is providing the voice of Princess Aurora in the 1959 Disney animated film Sleeping Beauty. She is the last surviving voice actress of the three Disney Princesses created in Walt Disney's lifetime and was named a Disney Legend in 1999." .

ng:Matsuo_Yokoyama_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Matsuo Yokoyama" ;
    sem:hasTimeStamp "1998-01-01"^^xsd:date ;
    rdfs:comment "Matsuo Yokoyama (横山 松夫, Yokoyama Matsuo; born 31 March 1927) is a Japanese businessman who was the president of Walt Disney Enterprises of Japan from 1989 to 1994. As a merchandise representative in the early 1960s he was responsible for establishing the enforcement of Disney's intellectual property rights in Japan." .

ng:Matt_Bomer_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Matt Bomer" ;
    sem:hasTimeStamp "1977-10-11"^^xsd:date ;
    rdfs:comment "Matthew Staton Bomer ( BOH-mər; born October 11, 1977) is an American actor. His works have earned him accolades including a Golden Globe Award, a Critics' Choice Television Award, and a Peabody Award, in addition to nominations for two Primetime Emmy Awards. Bomer made his television debut in 2000 on the long-running soap opera All My Children." .

ng:Matthew_Garber_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Matthew Garber" ;
    sem:hasTimeStamp "2004-01-01"^^xsd:date ;
    rdfs:comment "Matthew Adam Garber (25 March 1956 – 13 June 1977) was a British child actor, most notable as Michael Banks in the 1964 film Mary Poppins. His other screen credits include The Three Lives of Thomasina (1963) and The Gnome-Mobile (1967), appearing alongside actress Karen Dotrice in all three films they made for Walt Disney Pictures." .

ng:Maurice_Chevalier_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Maurice Chevalier" ;
    sem:hasTimeStamp "2002-01-01"^^xsd:date .

ng:Mel_Shaw_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Mel Shaw" ;
    sem:hasTimeStamp "2004-01-01"^^xsd:date .

ng:Meryl_Streep_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Meryl Streep" ;
    sem:hasTimeStamp "1980-01-01"^^xsd:date ;
    rdfs:comment "Mary Louise \"Meryl\" Streep (born June 22, 1949) is an American actress. Recognized as one of the most versatile performers of her era, Streep is noted for her technical precision, command of dialects, and professional longevity. She is an alumna of Vassar College and the Yale School of Drama, holding a Bachelor of Arts and a Master of Fine Arts." .

ng:Mia_Farrow_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Mia Farrow" ;
    sem:hasTimeStamp "1945-02-09"^^xsd:date .

ng:Michael_J_Fox_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Michael J. Fox" ;
    sem:hasTimeStamp "1989-01-01"^^xsd:date ;
    rdfs:comment "Michael Andrew Fox (born June 9, 1961), known professionally as Michael J. Fox, is a Canadian and American actor and activist. Beginning his career as a child actor in the 1970s, he rose to prominence portraying Alex P. Keaton on the NBC sitcom Family Ties (1982–1989) and Marty McFly in the Back to the Future film trilogy (1985–1990). Fox went on to star in films such as Teen Wolf (1985), The Secret of My Success (1987), Casualties of War (1989), Doc Hollywood (1991) and The Frighteners (1996)." .

ng:Michael_J_Fox_award_received_People_s_Choice_Award a sem:Event ;
    ng:object "People's Choice Award" ;
    ng:property "award received" ;
    ng:subject "Michael J. Fox" ;
    sem:hasTimeStamp "1997-01-01"^^xsd:date ;
    rdfs:comment "Michael Andrew Fox (born June 9, 1961), known professionally as Michael J. Fox, is a Canadian and American actor and activist. Beginning his career as a child actor in the 1970s, he rose to prominence portraying Alex P. Keaton on the NBC sitcom Family Ties (1982–1989) and Marty McFly in the Back to the Future film trilogy (1985–1990). Fox went on to star in films such as Teen Wolf (1985), The Secret of My Success (1987), Casualties of War (1989), Doc Hollywood (1991) and The Frighteners (1996)." .

ng:Mickey_Rooney_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Mickey Rooney" ;
    sem:hasTimeStamp "1981-01-01"^^xsd:date .

ng:Milt_Kahl_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Milt Kahl" ;
    sem:hasTimeStamp "1989-01-01"^^xsd:date ;
    rdfs:comment "Milton Erwin Kahl (March 22, 1909 – April 19, 1987) was an American animator. He was one of (and often considered the most influential of) Walt Disney's supervisory team of animators, known as Disney's Nine Old Men, recognised for his significant influence on character animation." .

ng:Misha_Collins_award_received_People_s_Choice_Award a sem:Event ;
