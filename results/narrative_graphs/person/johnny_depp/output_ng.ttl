    ng:subject "Emily Blunt" ;
    sem:hasTimeStamp "2006-01-01"^^xsd:date .

ng:Emma_Stone_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Emma Stone" ;
    sem:hasTimeStamp "2017-01-01"^^xsd:date ;
    rdfs:comment "Emily Jean \"Emma\" Stone (born November 6, 1988) is an American actress and film producer. Her accolades include two Academy Awards, two British Academy Film Awards, two Golden Globe Awards and a Volpi Cup. In 2017, she was the world's highest-paid actress and named by Time magazine as one of the 100 most influential people in the world." .

ng:Emma_Thompson_award_received_Golden_Globe_Award a sem:Event ;
