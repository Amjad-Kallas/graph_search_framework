ng:Ryan_Gosling_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Ryan Gosling" ;
    sem:hasTimeStamp "1980-11-12"^^xsd:date ;
    rdfs:comment "Ryan Thomas Gosling ( GOSS-ling; born November 12, 1980) is a Canadian actor. His work includes both independent films and major studio features. He has received various accolades including a Golden Globe Award, in addition to nominations for three Academy Awards, a Primetime Emmy Award, two British Academy Film Awards and nine Critics' Choice Awards." .

ng:Salvatore_Camarata_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
