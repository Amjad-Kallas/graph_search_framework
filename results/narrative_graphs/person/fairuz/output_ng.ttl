ng:Ziad_Rahbani_mother_Fairuz a sem:Event ;
    ng:object "Fairuz" ;
    ng:property "mother" ;
    ng:relatesTo ng:Fairuz_child_Ziad_Rahbani ;
    ng:subject "Ziad Rahbani" ;
    sem:hasTimeStamp "1956-01-01"^^xsd:date ;
    rdfs:comment "Ziad Rahbani (Arabic: زياد الرحباني, romanized:&#160;Ziyād ar-Raḥbānī; 1 January 1956 – 26 July 2025) was a Lebanese composer, pianist, playwright and political commentator. He was the son of Lebanese singer Fairuz and Lebanese composer Assi Rahbani. Many of his musicals satirize Lebanese Sectarian politics both during and after the Lebanese Civil War, and are often critical of the traditional political establishment." .

