ng:Adriana_Caselotti_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Adriana Caselotti" ;
    sem:hasTimeStamp "1994-01-01"^^xsd:date ;
    rdfs:comment "Adriana Elena Loretta Caselotti (May 6, 1916 – January 19, 1997) was an American actress and singer. Caselotti was best known as the voice of the title character of the first Walt Disney animated feature, Snow White and the Seven Dwarfs (1937), for which she was named a Disney Legend in 1994, making her the first female voice-over artist to achieve this." .

