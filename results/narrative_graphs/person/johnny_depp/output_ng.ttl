    sem:hasTimeStamp "2013-01-01"^^xsd:date .

ng:Daniel_Day_Lewis_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Daniel Day-Lewis" ;
    sem:hasTimeStamp "1957-04-29"^^xsd:date ;
    rdfs:comment "Sir Daniel Michael Blake Day-Lewis (born 29 April 1957) is an English actor. Widely regarded as one of the greatest actors in the history of cinema, he is best known for intense method acting portrayed with eccentric characters in auteurs' films. He is the recipient of numerous accolades, including a record three Academy Awards for Best Actor, as well as four BAFTAs, three Actor Awards and two Golden Globes." .

ng:Danny_Elfman_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
