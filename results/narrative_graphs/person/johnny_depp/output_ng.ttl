    sem:hasTimeStamp "2009-01-01"^^xsd:date .

ng:Eyvind_Earle_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Eyvind Earle" ;
    sem:hasTimeStamp "2015-01-01"^^xsd:date ;
    rdfs:comment "Eyvind Earle (April 26, 1916 – July 20, 2000) was an American artist, author and illustrator, noted for his contribution to the background illustration and styling of Disney's animated films in the 1950s. The Metropolitan Museum of Art, New York, Rahr West Art Museum, Phoenix Art Museum and Arizona State University Art Museum have purchased Earle's works for their permanent collections. His works have also been shown in many one-man exhibitions throughout the world." .

ng:Fess_Parker_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Fess Parker" ;
    sem:hasTimeStamp "1991-01-01"^^xsd:date .

ng:Floyd_Gottfredson_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Floyd Gottfredson" ;
    sem:hasTimeStamp "2003-01-01"^^xsd:date ;
    rdfs:comment "Arthur Floyd Gottfredson (May 5, 1905&#160;– July 22, 1986) was an American cartoonist best known for his defining work on the Mickey Mouse comic strip, which he worked on from 1930 until his retirement in 1975. His contribution to Mickey Mouse comics is comparable to Carl Barks's on the Donald Duck comics. 17 years after his death, his memory was honored with the Disney Legends award in 2003 and induction into the Comic Book Hall of Fame in 2006." .

ng:Floyd_Norman_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Floyd Norman" ;
    sem:hasTimeStamp "2007-01-01"^^xsd:date .

ng:Frank_Gifford_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Frank Gifford" ;
    sem:hasTimeStamp "2008-01-01"^^xsd:date ;
    rdfs:comment "Francis Newton Gifford (August 16, 1930 – August 9, 2015) was an American professional football player, actor, and television sports commentator. After a 12-year playing career as a halfback, flanker and safety for the New York Giants of the National Football League (NFL), he was a play-by-play announcer and commentator for 27 years on ABC's Monday Night Football. Gifford won the NFL Most Valuable Player Award from United Press International (UPI) in 1956, the same season his team won the NFL Championship." .

ng:Frank_Sinatra_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Frank Sinatra" ;
    sem:hasTimeStamp "1915-12-12"^^xsd:date ;
    rdfs:comment "Francis Albert Sinatra (; December 12, 1915 – May 14, 1998) was an American singer and actor. Nicknamed the \"Chairman of the Board\" and \"Ol' Blue Eyes\", he is regarded as one of the most influential entertainers of the 20th century. Born to Italian immigrants in Hoboken, New Jersey, Sinatra began his musical career in the swing era." .

ng:Frank_Thomas_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Frank Thomas" ;
    sem:hasTimeStamp "1989-01-01"^^xsd:date .

ng:Frank_Wells_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Frank Wells" ;
    sem:hasTimeStamp "1994-01-01"^^xsd:date .

ng:Fred_MacMurray_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Fred MacMurray" ;
    sem:hasTimeStamp "1987-01-01"^^xsd:date ;
    rdfs:comment "Frederick Martin MacMurray (August 30, 1908 – November 5, 1991) was an American actor. He appeared in more than one hundred films and a successful television series in a career that spanned nearly a half-century. His career as a major film leading man began in 1935, but his most renowned role was in Billy Wilder's 1944 film noir Double Indemnity." .

ng:Fulton_Burley_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Fulton Burley" ;
    sem:hasTimeStamp "1995-01-01"^^xsd:date ;
    rdfs:comment "Fulton Burley (June 12, 1922 – May 7, 2007) was a Canadian performer, most widely known for his work in Disneyland. Born in Toronto, Ontario, and raised in Windsor, Ontario, Canada, Fulton came to the United States in 1943 after a telephone audition landed him the singing lead in Billy Rose's Diamond Horseshoe Revue on Broadway. He later marveled at his \"Irish\" luck saying, \"The peculiar thing is I was at the Golden Horseshoe for 25 years, and I had started [my professional career] at the Diamond Horseshoe.\" At age 7, he performed in church weddings, and by 14, on" .

ng:Gabriel_Byrne_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Gabriel Byrne" ;
    sem:hasTimeStamp "1950-05-12"^^xsd:date .

ng:Garry_Marshall_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Garry Marshall" ;
    sem:hasTimeStamp "2017-01-01"^^xsd:date ;
    rdfs:comment "Garry Kent Marshall (November 13, 1934 – July 19, 2016) was an American screenwriter, director, producer and actor. Marshall began his career in the 1960s as a writer for The Lucy Show and The Dick Van Dyke Show until he developed the television adaptation of Neil Simon's play The Odd Couple. He rose to fame in the 1970s for creating the ABC sitcom Happy Days (1974–1984)." .

ng:George_Bodenheimer_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "George Bodenheimer" ;
    sem:hasTimeStamp "2015-01-01"^^xsd:date ;
    rdfs:comment "George Bodenheimer (born May 6, 1958) is the former president of ESPN Inc. and of ABC's sports division, known since 2006 as ESPN on ABC. He was president of ESPN since November 19, 1998 and of the former ABC Sports since March 3, 2003. The Sports Business Journal named Bodenheimer the most influential person of 2008 on a list of 50 people." .

ng:George_Bruns_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "George Bruns" ;
    sem:hasTimeStamp "2001-01-01"^^xsd:date ;
    rdfs:comment "George Edward Bruns (July 3, 1914 – May 23, 1983) was an American composer of music for film and television. His accolades include four Academy Award nominations and three Grammy Award nominations. He is mainly known for his compositions for numerous Disney films from the 1950s to the 1970s, among them Sleeping Beauty (1959), One Hundred and One Dalmatians, The Absent-Minded Professor (both 1961), The Sword in the Stone (1963), The Jungle Book (1967), The Love Bug (1968), The Aristocats (1970), and Robin Hood (1973)." .

ng:George_Lucas_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "George Lucas" ;
    sem:hasTimeStamp "2015-01-01"^^xsd:date ;
    rdfs:comment "George Walton Lucas Jr. (born May 14, 1944) is an American filmmaker and philanthropist. He created the Star Wars franchise and its fictional universe, the Indiana Jones franchise, and founded Lucasfilm, LucasArts, Industrial Light &amp; Magic and THX. Lucas also served as chairman of Lucasfilm before selling it to The Walt Disney Company in 2012. The recipient of two Emmy Awards and nominations for four Academy Awards and two Golden Globe Awards, he is considered to be one of the most significant figures of the 20th-century New Hollywood movement, and a pioneer of the modern blockbuster." .

ng:Ginny_Tyler_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Ginny Tyler" ;
    sem:hasTimeStamp "2006-01-01"^^xsd:date .

ng:Glen_Keane_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Glen Keane" ;
    sem:hasTimeStamp "2013-01-01"^^xsd:date ;
    rdfs:comment "Glen Keane is an American animator, director, author, and illustrator. As a character animator at Walt Disney Animation Studios for 38 years (1974–2012), he worked on feature films including The Little Mermaid, Beauty and the Beast, Aladdin, Pocahontas, Tarzan, and Tangled. He received the 1992 Annie Award for character animation and the 2007 Winsor McCay Award for lifetime contribution to the field of animation." .

ng:Glenn_Close_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Glenn Close" ;
