ng:Jack_Wrather_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Jack Wrather" ;
    sem:hasTimeStamp "2011-01-01"^^xsd:date ;
    rdfs:comment "John Devereaux Wrather Jr. (May 24, 1918 – November 12, 1984), was an entrepreneur and petroleum businessman who became a television producer and later diversified by investing in broadcast stations and resort properties. He is best known for producing The Lone Ranger, Sergeant Preston of the Yukon, and Lassie television series in the 1950s as well as marrying actress Bonita Granville. His daughter, Linda Wrather appeared in one of the last episodes of the Lone Ranger, The Angel and the Outlaw." .

