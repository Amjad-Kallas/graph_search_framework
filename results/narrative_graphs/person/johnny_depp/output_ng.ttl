ng:Dave_Smith_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Dave Smith" ;
    sem:hasTimeStamp "2007-01-01"^^xsd:date ;
    rdfs:comment "David Rollin Smith (October 13, 1940 – February 15, 2019) was the founder and chief archivist of the Walt Disney Archives, the corporate archive of The Walt Disney Company." .

ng:David_Hand_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
