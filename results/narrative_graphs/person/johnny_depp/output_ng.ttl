ng:Van_Arsdale_France_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Van Arsdale France" ;
    sem:hasTimeStamp "1994-01-01"^^xsd:date ;
    rdfs:comment "Joseph Van Arsdale France (October 3 1912 – October 13 1999) is credited with establishing the process for training new employees in Disney-owned and other \"theme parks\" around the world." .

ng:Virginia_Davis_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Virginia Davis" ;
    sem:hasTimeStamp "1998-01-01"^^xsd:date .

ng:Wally_Boag_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Wally Boag" ;
    sem:hasTimeStamp "1995-01-01"^^xsd:date ;
    rdfs:comment "Wallace Vincent Boag (September 13, 1920 – June 3, 2011) was an American performer known for his starring role in Disney's long-running stage show the Golden Horseshoe Revue and as the voice of Jose the parrot in Walt Disney's Enchanted Tiki Room." .

ng:Ward_Kimball_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Ward Kimball" ;
    sem:hasTimeStamp "1989-01-01"^^xsd:date .

ng:Wayne_Allwine_award_received_Disney_Legends a sem:Event ;
    ng:object "Disney Legends" ;
    ng:property "award received" ;
    ng:subject "Wayne Allwine" ;
    sem:hasTimeStamp "2008-01-01"^^xsd:date ;
    rdfs:comment "Wayne Anthony Allwine (February 7, 1947 – May 18, 2009) was an American voice actor, sound effects editor, and foley artist. He was best known as the third official voice of Mickey Mouse in English (following Walt Disney and Jimmy MacDonald) and the first official casting following the establishment of Disney Character Voices International in 1988. To date, he holds the record for the longest-running voice actor to play Mickey Mouse, having performed the role for 32 years." .

ng:Wes_Anderson_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Wes Anderson" ;
    sem:hasTimeStamp "1969-05-01"^^xsd:date .

ng:Whoopi_Goldberg_award_received_Golden_Globe_Award a sem:Event ;
    ng:object "Golden Globe Award" ;
    ng:property "award received" ;
    ng:subject "Whoopi Goldberg" ;
    sem:hasTimeStamp "1986-01-01"^^xsd:date ;
    rdfs:comment "Caryn Elaine Johnson (born November 13, 1955), known professionally as Whoopi Goldberg (), is an American actor, comedian, author, and television personality. She is one of 28 entertainers to receive the EGOT, consisting of an Emmy, a Grammy, an Oscar (Academy Award), and a Tony Award. Her other accolades include a BAFTA and two Golden Globes." .

ng:Wilfred_Jackson_award_received_Disney_Legends a sem:Event ;
